DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DATABASE_URL=sqlite:///db.sqlite3
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5000
MAX_UPLOAD_MB=20
AI_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
FIREBASE_PROJECT_ID=
# Keep service-account credentials private; use this env var or GOOGLE_APPLICATION_CREDENTIALS locally.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-api-domain.example/api/integrations/instagram/callback/
INSTAGRAM_GRAPH_VERSION=v25.0
PUBLIC_API_ORIGIN=https://your-api-domain.example
